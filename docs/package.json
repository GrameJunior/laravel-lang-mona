{
    "name": "laravel-lang-documentation",
    "private": true,
    "engines": {
        "node": ">=26.10.0"
    },
    "scripts": {
        "start": "docusaurus start",
        "build": "docusaurus build && pagefind --site build --root-selector .theme-doc-markdown",
        "serve": "sirv build --host 127.0.0.1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@mdx-js/react": "3.1.1",
        "prism-react-renderer": "2.4.1",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "3.10.2",
        "@docusaurus/tsconfig": "3.10.2",
        "@docusaurus/types": "3.10.2",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "pagefind": "1.6.0",
        "sirv-cli": "3.0.1",
        "typescript": "5.9.3"
    }
}
