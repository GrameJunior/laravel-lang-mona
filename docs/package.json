{
    "name": "laravel-lang-documentation",
    "private": true,
    "engines": {
        "node": ">=26.10.0"
    },
    "scripts": {
        "start": "docusaurus start",
        "build": "docusaurus build && pagefind --site build --root-selector .theme-doc-markdown",
        "serve": "sirv build --host 127.0.0.1"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@mdx-js/react": "3.1.1",
        "prism-react-renderer": "2.4.1",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "pagefind": "1.6.0",
        "sirv-cli": "3.0.1"
    }
}
