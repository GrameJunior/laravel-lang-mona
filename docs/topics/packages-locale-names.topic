<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
    SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
    title="Locale Names" id="packages-locale-names">

    <show-structure depth="2" />

    <link-summary>Translation of locale names</link-summary>
    <card-summary>Translation of locale names</card-summary>
    <web-summary>Translation of locale names</web-summary>

    <primary-label ref="stable" />
    <secondary-label ref="package-locale-names" />

    <include from="library-share.topic" element-id="view_on_github">
        <var name="package" value="%package-locale-names%" />
    </include>

    <tip>
        This package contains a list of localized locale names.
    </tip>

    <chapter title="Installation" id="installation">
        <link-summary>Installation information for the %repository-title-locale-names% package</link-summary>

        <note>
            The compatibility table can be viewed <a href="#compatibility">here</a>.
        </note>

        <p>
            To install, run the console command:
        </p>

        <code-block lang="bash">
            %install-locale-names%
        </code-block>
    </chapter>

    <chapter title="Usage" id="usage">
        <link-summary>Usage information for the %repository-title-locale-names% package</link-summary>

        <chapter title="Localized Names" id="localized_names">
            <code-block lang="php">
                use LaravelLang\LocaleList\Locale;
                use LaravelLang\LocaleNames\LocaleNames;

                $names = app(LocaleNames::class);

                return $names->all('bn')->pluck('localized', 'code')->all();
                // or
                return $names->all(Locale::Bengali)->pluck('localized', 'code')->all();
            </code-block>

            <code-block
                lang="php"
                src="usage-locale-names-localized-names.txt"
                collapsed-title="Show result"
                collapsible="true"
                default-state="collapsed"
            />
        </chapter>

        <chapter title="Native Names" id="native_names">
            <p>
                Pass <code>null</code> or an empty string to <code>all</code> to get names in their native languages.
            </p>

            <code-block lang="php">
                use LaravelLang\LocaleNames\LocaleNames;

                return app(LocaleNames::class)->all(null)->pluck('native', 'code')->all();
            </code-block>

            <code-block
                lang="php"
                src="usage-locale-names-native-names.txt"
                collapsed-title="Show result"
                collapsible="true"
                default-state="collapsed"
            />
        </chapter>

        <chapter title="Sorting" id="sorting">
            <p>
                Use <code>sortKeys</code> on the collection to sort by locale code, or pass a <code>SortDirection</code>
                to <code>all</code> to sort by localized name.
            </p>

            <chapter title="Sort by keys" id="sort_by_keys">
                <code-block lang="php">
                    use LaravelLang\LocaleNames\LocaleNames;

                    return app(LocaleNames::class)->all('en')->sortKeys()->pluck('localized', 'code')->all();
                </code-block>

                <code-block
                    lang="php"
                    src="usage-locale-names-sort-by-keys.txt"
                    collapsed-title="Show result"
                    collapsible="true"
                    default-state="collapsed"
                />
            </chapter>

            <chapter title="Sort by values" id="sort_by_values">
                <code-block lang="php">
                    use LaravelLang\LocaleNames\LocaleNames;

                    return app(LocaleNames::class)
                        ->all('en', \SortDirection::Ascending)
                        ->pluck('localized', 'code')
                        ->all();
                </code-block>

                <code-block
                    lang="php"
                    src="usage-locale-names-sort-by-values.txt"
                    collapsed-title="Show result"
                    collapsible="true"
                    default-state="collapsed"
                />
            </chapter>
        </chapter>
    </chapter>

    <chapter title="Compatibility" id="compatibility">
        <link-summary>Compatibility table for the %repository-title-locale-names% package</link-summary>

        <p>The versions below were published as <code>laravel-lang/native-locale-names</code>.</p>

        <table>
            <tr>
                <td>PHP</td>
                <td>Package</td>
                <td>Status</td>
            </tr>
            <tr>
                <td>8.1, 8.2, 8.3, 8.4, 8.5</td>
                <td><code>^2.0</code></td>
                <td><img src="%badge-supported%" alt="supported" /></td>
            </tr>
            <tr>
                <td>8.1, 8.2, 8.3</td>
                <td><code>^1.0</code></td>
                <td><img src="%badge-not-supported%" alt="not supported" /></td>
            </tr>
        </table>
    </chapter>
</topic>
