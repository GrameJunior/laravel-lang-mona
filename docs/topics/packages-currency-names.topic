<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
    SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
    title="Currency Names" id="packages-currency-names">

    <show-structure depth="2" />

    <link-summary>Translation of currency names</link-summary>
    <card-summary>Translation of currency names</card-summary>
    <web-summary>Translation of currency names</web-summary>

    <tip>
        This package contains a list of localized currency names.
    </tip>

    <chapter title="Installation" id="installation">
        <link-summary>Installation information for the %repository-title-currency-names% package</link-summary>

        <p>
            Mona includes this module as <code>%package-currency-names%</code>. The standalone package
            under this name is pending publication.
        </p>

        <p>
            The current standalone release is <a href="https://github.com/%package-native-currency-names%">%package-native-currency-names%</a>.
            Install it with this command.
        </p>

        <code-block lang="bash">
            %install-native-currency-names%
        </code-block>
    </chapter>

    <chapter title="Usage" id="usage">
        <link-summary>Usage information for the %repository-title-currency-names% module</link-summary>

        <p>These examples use the Mona API.</p>

        <chapter title="Localized Names" id="localized_names">
            <p>Pass the display locale as a locale code.</p>

            <code-block lang="php">
                use LaravelLang\CurrencyNames\CurrencyNames;

                return app(CurrencyNames::class)->all('bn')->map->localized->all();
            </code-block>

            <p>You can also pass a <code>Locale</code> case.</p>

            <code-block lang="php">
                use LaravelLang\CurrencyNames\CurrencyNames;
                use LaravelLang\LocaleList\Locale;

                return app(CurrencyNames::class)->all(Locale::Bengali)->map->localized->all();
            </code-block>

            <p>
                Result:
            </p>

            <code-block
                lang="php"
                src="usage-currency-names-localized-names.txt"
                collapsed-title="Show result"
                collapsible="true"
                default-state="collapsed"
            />
        </chapter>

        <chapter title="Native Names" id="native_names">
            <p>
                Pass <code>null</code> as the display locale to get the currency names in their native languages.
            </p>

            <code-block lang="php">
                use LaravelLang\CurrencyNames\CurrencyNames;

                return app(CurrencyNames::class)->all(null)->map->native->all();
            </code-block>

            <p>
                Result:
            </p>

            <code-block
                lang="php"
                src="usage-currency-names-native-names.txt"
                collapsed-title="Show result"
                collapsible="true"
                default-state="collapsed"
            />
        </chapter>

        <chapter title="Sorting" id="sorting">
            <p>
                Use <code>sortKeys()</code> on the collection to sort by locale code, or pass a
                <code>SortDirection</code> to <code>all()</code> to sort by localized currency name.
            </p>

            <chapter title="Sort by keys" id="sort_by_keys">
                <code-block lang="php">
                    use LaravelLang\CurrencyNames\CurrencyNames;

                    return app(CurrencyNames::class)->all('en')->sortKeys()->map->localized->all();
                </code-block>

                <p>
                    Result:
                </p>

                <code-block
                    lang="php"
                    src="usage-currency-names-sort-by-keys.txt"
                    collapsed-title="Show result"
                    collapsible="true"
                    default-state="collapsed"
                />
            </chapter>

            <chapter title="Sort by values" id="sort_by_values">
                <code-block lang="php">
                    use LaravelLang\CurrencyNames\CurrencyNames;

                    return app(CurrencyNames::class)
                        ->all('en', SortDirection::Ascending)
                        ->map->localized->all();
                </code-block>

                <p>
                    Result:
                </p>

                <code-block
                    lang="php"
                    src="usage-currency-names-sort-by-values.txt"
                    collapsed-title="Show result"
                    collapsible="true"
                    default-state="collapsed"
                />
            </chapter>
        </chapter>
    </chapter>

    <chapter title="Compatibility" id="compatibility">
        <link-summary>Compatibility table for the current standalone release</link-summary>

        <p>This table applies to the published <code>%package-native-currency-names%</code> package.</p>

