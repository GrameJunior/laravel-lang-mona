<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
    SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
    title="Country Names" id="packages-country-names">

    <show-structure depth="2" />

    <link-summary>Translation of country names</link-summary>
    <card-summary>Translation of country names</card-summary>
    <web-summary>Translation of country names</web-summary>

    <primary-label ref="stable" />
    <secondary-label ref="package-country-names" />

    <include from="library-share.topic" element-id="view_on_github">
        <var name="package" value="%package-country-names%" />
    </include>

    <tip>
        This package contains a list of localized country names.
    </tip>

    <chapter title="Installation" id="installation">
        <link-summary>Installation information for the %repository-title-country-names% package</link-summary>

        <note>
            The compatibility table can be viewed <a href="#compatibility">here</a>.
        </note>

        <p>
            To install, run the console command:
        </p>

        <code-block lang="bash">
            %install-country-names%
        </code-block>
    </chapter>

    <chapter title="Usage" id="usage">
        <link-summary>Usage information for the %repository-title-country-names% package</link-summary>

        <chapter title="Localized Names" id="localized_names">
            <p>
                The <code>all</code> method returns a collection of <code>CountryData</code> objects keyed by locale.
                Use <code>one</code> to look up a single country.
            </p>

            <code-block lang="php">
                use LaravelLang\CountryNames\CountryNames;
                use LaravelLang\LocaleList\Locale;

                $names = app(CountryNames::class);

                $names->all('bn');
                $names->all(Locale::Bengali);
                $names->one(Locale::Bengali, Locale::French)->localized; // 'ফ্রান্স'
            </code-block>
        </chapter>

        <chapter title="Native Names" id="native_names">
            <p>
                Pass <code>null</code> as the display locale to get country names in their native languages.
            </p>

            <code-block lang="php">
                use LaravelLang\CountryNames\CountryNames;
                use LaravelLang\LocaleList\Locale;

                $names = app(CountryNames::class);

                $names->all(null);
                $names->one(null, Locale::French)->native; // 'France'
            </code-block>
        </chapter>

        <chapter title="Sorting" id="sorting">
            <p>
                Sort the collection by locale with <code>sortKeys</code>. Pass a <code>SortDirection</code> to
                <code>all</code> to sort by localized country name.
            </p>

            <chapter title="Sort by keys" id="sort_by_keys">
                <code-block lang="php">
                    use LaravelLang\CountryNames\CountryNames;

                    return app(CountryNames::class)->all('en')->sortKeys();
                </code-block>
            </chapter>

            <chapter title="Sort by values" id="sort_by_values">
                <code-block lang="php">
                    use LaravelLang\CountryNames\CountryNames;

                    return app(CountryNames::class)->all('en', SortDirection::Ascending);
                </code-block>
            </chapter>
        </chapter>
    </chapter>

