{
    "name": "laravel-lang/mona",
    "description": "Easily connect the necessary language packs to the application",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "actions",
        "attributes",
        "country-names",
        "currency-names",
        "http-statuses",
        "json-fallback",
        "lang",
        "languages",
        "laravel",
        "laravel-lang",
        "locale",
        "locale-list",
        "locale-names",
        "locales",
        "localization",
        "models",
        "moonshine",
        "routes",
        "starter-kits",
        "translatable-routes",
        "translate-models",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro",
            "homepage": "https://dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "homepage": "https://laravel-lang.com",
    "support": {
        "issues": "https://github.com/Laravel-Lang/mona/issues",
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "dragon-code/benchmark": "^4.6",
        "laravel/pao": "^1.1",
        "orchestra/testbench": "^11.0",
        "symfony/var-dumper": "^8.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Config\\": "src/Config/src/",
            "LaravelLang\\CountryNames\\": "src/CountryNames/src/",
            "LaravelLang\\CurrencyNames\\": "src/CurrencyNames/src/",
            "LaravelLang\\JsonFallback\\": "src/JsonFallback/src/",
            "LaravelLang\\LocaleList\\": "src/LocaleList/src/",
            "LaravelLang\\LocaleNames\\": "src/LocaleNames/src/",
            "LaravelLang\\Locales\\": "src/Locales/src/",
            "LaravelLang\\Models\\": "src/Models/src/",
            "LaravelLang\\Publisher\\": "src/Publisher/src/",
            "LaravelLang\\Routes\\": "src/Routes/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "vendor/bin/phpunit"
    }
}
