            <directory>src/Actions/source</directory>
            <directory>src/Attributes/source</directory>
            <directory>src/HttpStatuses/source</directory>
            <directory>src/Common</directory>
            <directory>src/Lang/source</directory>
            <directory>src/MoonShine/source</directory>
            <directory>src/TranslationsTemplate/source</directory>
            <directory>src/Models/stubs</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_KEY" value="AckfSECXIvnK5r28GVIWUAxmbBSjTsmF" />
        <env name="APP_LOCALE" value="fr" />
        <env name="APP_FALLBACK_LOCALE" value="de" />

        <env name="SESSION_DRIVER" value="array" />
        <env name="CACHE_STORE" value="array" />
