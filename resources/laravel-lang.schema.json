{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Laravel-Lang/mona/main/resources/laravel-lang.schema.json",
    "title": "Laravel Lang translation manifest",
    "type": "object",
    "additionalProperties": false,
    "required": ["plugins"],
    "properties": {
        "plugins": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/plugin"
            }
        }
    },
    "$defs": {
        "plugin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files"],
            "dependentRequired": {
                "version": ["vendor"],
                "project": ["vendor"]
            },
            "properties": {
                "vendor": {
                    "description": "Composer package name.",
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "description": "Composer version constraint for the package.",
                    "type": "string",
                    "minLength": 1
                },
                "project": {
                    "description": "Allow matching the root Composer project by package name.",
                    "type": "boolean"
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/file"
                    }
                }
            }
        },
        "file": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
                "source": {
                    "description": "Path relative to the package's translation source directory.",
                    "type": "string",
                    "minLength": 1
                },
                "target": {
                    "description": "Path relative to the application's language directory, with a {locale} placeholder.",
                    "type": "string",
                    "pattern": "\\{locale\\}"
                }
            }
        }
    }
}
