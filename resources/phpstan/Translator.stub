<?php

declare(strict_types=1);

namespace Illuminate\Translation;

class Translator
{
    /** @var array<array-key, array<array-key, array<array-key, array<array-key, mixed>>>> */
    protected $loaded = [];

    /**
     * @param  string  $key
     * @return array{string, string, string|null}
     */
    public function parseKey($key) {}

    /**
     * @param  string|null  $locale
     * @return array<array-key, string>
     */
    protected function localeArray($locale) {}

    /**
     * @param  string  $namespace
     * @param  string  $group
     * @param  string  $locale
     * @param  string|null  $item
     * @param  array<array-key, mixed>  $replace
     * @return array<array-key, mixed>|string|null
     */
    protected function getLine($namespace, $group, $locale, $item, array $replace) {}

    /**
     * Without replacements Laravel returns the input. With replacements it delegates
     * to PHP string functions, which may coerce the input or throw a TypeError.
     *
     * @template TLine
     *
     * @param  TLine  $line
     * @param  array<array-key, mixed>  $replace
     * @return ($replace is array{} ? TLine : string)
     */
    protected function makeReplacements($line, array $replace) {}
}
