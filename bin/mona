#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dotenv\Dotenv;
use LaravelLang\Mona\Commands\Cldr\CldrCountryCommand;
use LaravelLang\Mona\Commands\Cldr\CldrCountryNativeCommand;
use LaravelLang\Mona\Commands\Cldr\CldrCurrencyCommand;
use LaravelLang\Mona\Commands\Cldr\CldrCurrencyNativeCommand;
use LaravelLang\Mona\Commands\Cldr\CldrLocaleCommand;
use LaravelLang\Mona\Commands\Cldr\CldrLocaleNativeCommand;
use LaravelLang\Mona\Commands\LibraryCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$dotenv = Dotenv::createImmutable(__DIR__ . '/../');
$dotenv->safeLoad();

$application = new Application('Laravel-Lang: Mona');

$application->addCommands([
    new CldrCountryCommand,
    new CldrCountryNativeCommand,
    new CldrCurrencyCommand,
    new CldrCurrencyNativeCommand,
    new CldrLocaleCommand,
    new CldrLocaleNativeCommand,
    new LibraryCommand,
]);

$application->run();
