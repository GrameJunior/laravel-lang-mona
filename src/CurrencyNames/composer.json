{
    "name": "laravel-lang/currency-names",
    "description": "The project contains native translations of currency names",
    "minimum-stability": "stable",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Laravel-Lang/mona/issues",
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "keywords": [
        "lang",
        "languages",
        "laravel",
        "laravel-lang",
        "locale",
        "locales",
        "localization",
        "translation",
        "translations",
        "currency"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel-lang/support": "self.version"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\CurrencyNames\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
