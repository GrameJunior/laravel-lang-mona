{
    "$schema": "https://raw.githubusercontent.com/Laravel-Lang/mona/main/resources/laravel-lang.schema.json",
    "plugins": [
        {
            "files": [
                {
                    "source": "foo.php",
                    "target": "{locale}/auth.php"
                },
                {
                    "source": "bar.php",
                    "target": "{locale}/bar.php"
                },
                {
                    "source": "baz.json",
                    "target": "{locale}.json"
                }
            ]
        }
    ]
}
